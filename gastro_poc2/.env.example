# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
# Production (Supabase / any managed Postgres): set a single DATABASE_URL and it
# takes precedence over everything below. For a persistent server (Render), use
# Supabase's *Session pooler* string (port 5432, host *.pooler.supabase.com) —
# it's IPv4 and behaves like a normal connection.
#   DATABASE_URL=postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Local dev without DATABASE_URL falls back to the discrete vars below:
# DB_ENGINE=postgres  → use Postgres (docker-compose up -d db)
# DB_ENGINE=sqlite    → use a local sqlite file (quick start, no Docker)
DB_ENGINE=postgres
POSTGRES_DB=gastro
POSTGRES_USER=gastro
POSTGRES_PASSWORD=gastro
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ── AI provider (same options as POC1) ───────────────────────────────────────
# AI_PROVIDER=gemini | openai | anthropic | openrouter
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
