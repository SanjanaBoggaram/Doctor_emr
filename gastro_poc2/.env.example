# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
# DB_ENGINE=postgres  → use Postgres (docker-compose up -d db)
# DB_ENGINE=sqlite    → use a local sqlite file (quick start, no Docker)
DB_ENGINE=postgres
POSTGRES_DB=gastro
POSTGRES_USER=gastro
POSTGRES_PASSWORD=gastro
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ── AI provider (same options as POC1) ───────────────────────────────────────
# AI_PROVIDER=gemini | openai | anthropic | openrouter
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# ── RAG (intake agent retrieval; see rag_data/) ──────────────────────────────
RAG_ENABLED=false
RAG_EMBED_PROVIDER=local       # local (offline ONNX) | gemini (needs GEMINI_API_KEY)
RAG_TOP_K=4
# RAG_EMBED_MODEL=models/text-embedding-004   # only for the gemini provider
